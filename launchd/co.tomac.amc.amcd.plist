<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>@ID@.amcd</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>@ROOT@/bin/amcd</string></array>
  <key>EnvironmentVariables</key><dict><key>AMC_FLAG</key><string>@AMCHOME@/hands-off</string><key>AMC_LOG</key><string>@HOME@/Library/Logs/amcd@SUF@.log</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/amcd@SUF@.err.log</string>
</dict></plist>
